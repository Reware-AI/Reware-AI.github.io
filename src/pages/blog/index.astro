---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';

const blogPosts = await getCollection('blog');
// Sort by publication date, newest first
const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="RewareAI Blog">
  <div class="blog-container">
    <nav class="blog-nav">
      <div class="blog-nav-container">
        <a href="/" class="blog-nav-logo">RewareAI</a>
        <a href="/" class="blog-nav-back">← Back to Homepage</a>
      </div>
    </nav>
    
    <div class="blog-header">
      <h1 class="blog-title">Our Blog</h1>
      <p class="blog-description">
        Insights and updates on AI-powered security scanning and modern software security practices
      </p>
    </div>
    
    <div class="blog-posts">
      {sortedPosts.map(post => (
        <div class="blog-post-card">
          <a href={`/blog/${post.slug}`} class="blog-post-image-link">
            <div class="blog-post-image-container">
              <img src={post.data.thumbnail.startsWith('/') ? post.data.thumbnail : `/${post.data.thumbnail}`} alt={post.data.title} class="blog-post-image" />
            </div>
          </a>
          <div class="blog-post-content">
            <div class="blog-post-meta">
              <span class="blog-post-date">{format(post.data.pubDate, 'MMMM d, yyyy')}</span>
              {post.data.tags && post.data.tags.length > 0 && (
                <span class="blog-post-primary-tag">{post.data.tags[0]}</span>
              )}
            </div>
            <a href={`/blog/${post.slug}`} class="blog-post-title-link">
              <h2 class="blog-post-title">{post.data.title}</h2>
            </a>
            <p class="blog-post-description">{post.data.description}</p>
            <div class="blog-post-footer">
              <span class="blog-post-author">By {post.data.author}</span>
              <a href={`/blog/${post.slug}`} class="blog-post-read-more">Read More →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="blog-subscribe">
      <div class="blog-subscribe-content">
        <h2 class="blog-subscribe-title">Stay Updated</h2>
        <p class="blog-subscribe-description">
          Subscribe to our newsletter to receive the latest updates on AI security and vulnerability scanning.
        </p>
        <form class="blog-subscribe-form">
          <input type="email" placeholder="Your email address" class="blog-subscribe-input" />
          <button type="submit" class="blog-subscribe-button">Subscribe</button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  .blog-nav {
    padding: 2rem 0;
  }
  
  .blog-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .blog-nav-logo {
    color: #00ffcc;
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
  }
  
  .blog-nav-back {
    color: white;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .blog-nav-back:hover {
    color: #00ffcc;
  }
  
  .blog-header {
    text-align: center;
    margin: 3rem 0 5rem;
  }
  
  .blog-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 1.5rem 0;
    background: linear-gradient(135deg, #ffffff 0%, #00ffcc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .blog-description {
    font-size: 1.25rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .blog-posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 3rem;
    margin-bottom: 5rem;
  }
  
  .blog-post-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(0, 255, 204, 0.1);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  
  .blog-post-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 255, 204, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }
  
  .blog-post-image-container {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }
  
  .blog-post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .blog-post-card:hover .blog-post-image {
    transform: scale(1.05);
  }
  
  .blog-post-content {
    padding: 1.5rem;
  }
  
  .blog-post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  
  .blog-post-date {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }
  
  .blog-post-primary-tag {
    background: rgba(0, 255, 204, 0.1);
    border: 1px solid rgba(0, 255, 204, 0.3);
    color: #00ffcc;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }
  
  .blog-post-title-link {
    text-decoration: none;
  }
  
  .blog-post-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 1rem 0;
    color: white;
    transition: color 0.3s ease;
  }
  
  .blog-post-title-link:hover .blog-post-title {
    color: #00ffcc;
  }
  
  .blog-post-description {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }
  
  .blog-post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .blog-post-author {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }
  
  .blog-post-read-more {
    color: #00ffcc;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity 0.3s ease;
  }
  
  .blog-post-read-more:hover {
    opacity: 0.8;
  }
  
  .blog-subscribe {
    background: linear-gradient(135deg, rgba(0, 255, 204, 0.1) 0%, rgba(0, 212, 170, 0.05) 100%);
    border: 1px solid rgba(0, 255, 204, 0.2);
    border-radius: 20px;
    padding: 3rem;
    margin-bottom: 5rem;
  }
  
  .blog-subscribe-content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  
  .blog-subscribe-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: white;
  }
  
  .blog-subscribe-description {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  
  .blog-subscribe-form {
    display: flex;
    gap: 1rem;
  }
  
  .blog-subscribe-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    color: white;
    font-size: 1rem;
  }
  
  .blog-subscribe-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  
  .blog-subscribe-button {
    background: linear-gradient(135deg, #00ffcc 0%, #00d4aa 100%);
    color: #1a1b3a;
    border: none;
    border-radius: 12px;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .blog-subscribe-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 255, 204, 0.3);
  }
  
  @media (max-width: 768px) {
    .blog-posts {
      grid-template-columns: 1fr;
    }
    
    .blog-subscribe {
      padding: 2rem;
    }
    
    .blog-subscribe-form {
      flex-direction: column;
    }
    
    .blog-subscribe-button {
      width: 100%;
    }
  }
</style>
