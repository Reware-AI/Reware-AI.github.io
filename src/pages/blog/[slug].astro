---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { format } from 'date-fns';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly for server-side rendering
const { slug } = Astro.params;
let entry = Astro.props.entry;

// If entry is not available from props (in SSR mode), get it directly
if (!entry && slug) {
  entry = await getEntry('blog', slug);
}

// Add error handling to prevent "Cannot read properties of undefined" error
let Content;
try {
  if (entry) {
    const rendered = await entry.render();
    Content = rendered.Content;
  }
} catch (error) {
  console.error(`Error rendering blog post content: ${error instanceof Error ? error.message : String(error)}`);
  // We'll handle the error in the template
}
---

<Layout title={entry ? `${entry.data.title} - RewareAI Blog` : 'Error - RewareAI Blog'}>
  {!Content ? (
    <div class="error-container">
      <h1>Error Loading Blog Post</h1>
      <p>We're sorry, but there was an error loading this blog post.</p>
      <a href="/blog">Return to Blog</a>
    </div>
  ) : (
    <div class="blog-post-container">
      <nav class="blog-nav">
        <div class="blog-nav-container">
          <a href="/" class="blog-nav-logo">RewareAI</a>
          <a href="/blog" class="blog-nav-back">← Back to Blog</a>
        </div>
      </nav>
      
      <div class="blog-post-header">
        <div class="blog-post-image-container">
          <img src={entry.data.thumbnail.startsWith('/') ? entry.data.thumbnail : `/${entry.data.thumbnail}`} alt={entry.data.title} class="blog-post-image" />
        </div>
      <div class="blog-post-meta">
        <h1 class="blog-post-title">{entry.data.title}</h1>
        <div class="blog-post-details">
          <span class="blog-post-author">By {entry.data.author}</span>
          <span class="blog-post-date">{format(entry.data.pubDate, 'MMMM d, yyyy')}</span>
        </div>
        {entry.data.tags && (
          <div class="blog-post-tags">
            {entry.data.tags.map(tag => (
              <span class="blog-post-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
    
    <article class="blog-post-content">
      <Content />
    </article>
    
    <div class="blog-post-footer">
      <a href="/blog" class="btn btn-secondary">Back to All Posts</a>
      <div class="blog-post-share">
        <span>Share this post:</span>
        <div class="blog-post-share-icons">
          <a href={`https://twitter.com/intent/tweet?text=${entry.data.title}&url=${Astro.url}`} target="_blank" class="share-icon">Twitter</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} target="_blank" class="share-icon">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
)}
</Layout>

