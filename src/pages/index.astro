---
import Layout from '../layouts/Layout.astro';
import FeaturedBlog from '../components/FeaturedBlog.astro';
---

<Layout>
	<!-- Navigation -->
	<nav class="navbar">
		<div class="nav-container">
			<div class="nav-logo">
				<h2>RewareAI</h2>
			</div>
			<ul class="nav-menu">
				<li class="nav-item">
					<a href="#features" class="nav-link">Features</a>
				</li>
					<li class="nav-item">
					<a href="blog" class="nav-link">Blog</a>
				</li>
				<li class="nav-item">
					<a href="#demo" class="nav-link">Demo</a>
				</li>
				<li class="nav-item">
					<a href="#contact" class="nav-link">Contact</a>
				</li>
			</ul>
		</div>
	</nav>

	<!-- Hero Section -->
	<main class="hero">
		<!-- Hero Background -->
		<div class="hero-background"></div>
		
		<div class="hero-container">
			<h1 class="hero-title">
				Next-Gen AI-Native
				<br />
				Security Scanning for
				<br />
				Modern Software
			</h1>
			<p class="hero-description">
				Automatically detect and remediate vulnerabilities in your codebase with
				intelligent, AI-powered security scanning.
			</p>
			<div class="hero-buttons">
				<a href="#contact"><button class="btn btn-primary">Request a Demo</button></a>
				
			</div>
		</div>
	</main>

	<!-- Features Section -->
	<section id="features" class="features">
		<div class="features-container">
			<div class="features-header">
				<h2 class="features-title">AI-Powered Security Revolution</h2>
				<p class="features-subtitle">
					Transform your development workflow with intelligent security scanning that adapts to your codebase
				</p>
			</div>
			
			<div class="features-grid">
				<div class="feature-card">
					<div class="feature-icon">
						<div class="icon-bg brain-icon">🧠</div>
					</div>
					<h3 class="feature-title">AI-Driven Scanning</h3>
					<p class="feature-description">
						Intelligent analysis of source code, dependencies, and configuration files using advanced AI agents.
					</p>
				</div>

				<div class="feature-card">
					<div class="feature-icon">
						<div class="icon-bg lightning-icon">⚡</div>
					</div>
					<h3 class="feature-title">Real-Time Detection</h3>
					<p class="feature-description">
						Instant identification of vulnerabilities, misconfigurations, and secret leaks as you code.
					</p>
				</div>

				<div class="feature-card">
					<div class="feature-icon">
						<div class="icon-bg target-icon">🎯</div>
					</div>
					<h3 class="feature-title">Context-Aware Suggestions</h3>
					<p class="feature-description">
						Smart remediation recommendations tailored to your specific codebase and development context.
					</p>
				</div>

				<div class="feature-card">
					<div class="feature-icon">
						<div class="icon-bg integration-icon">🔄</div>
					</div>
					<h3 class="feature-title">CI/CD Integration</h3>
					<p class="feature-description">
						Seamless integration with your existing development pipeline for continuous security monitoring.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Blog Section -->
	<FeaturedBlog />

	<!-- Contact Section -->
	<section id="contact" class="contact">
		<div class="contact-container">
			<div class="contact-header">
				<h2 class="contact-title">Get in Touch</h2>
				<p class="contact-subtitle">
					Have questions about our AI security solutions? Contact us today and our team will get back to you shortly.
				</p>
			</div>
			
			<div class="contact-content">
				<div class="contact-form-container">
					<form id="contact-form" class="contact-form" action="/api/contact" method="POST">
						<div class="form-group">
							<label for="name">Name <span class="required">*</span></label>
							<input type="text" id="name" name="name" class="form-control" required>
						</div>
						
						<div class="form-group">
							<label for="email">Email <span class="required">*</span></label>
							<input type="email" id="email" name="email" class="form-control" required>
						</div>
						
						<!-- Honeypot field to catch bots -->
						<div class="form-group" style="display:none;">
							<label for="website">Website</label>
							<input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
						</div>
						
						<div class="form-group">
							<label for="subject">Subject</label>
							<input type="text" id="subject" name="subject" class="form-control">
						</div>
						
						<div class="form-group">
							<label for="message">Message <span class="required">*</span></label>
							<textarea id="message" name="message" class="form-control" rows="5" required></textarea>
						</div>
						
						<div id="form-status" class="form-status" role="alert" aria-live="polite"></div>
						
						<button type="submit" class="btn btn-primary contact-submit-btn">Send Message</button>
					</form>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Footer Section -->
	<footer class="footer">
		<div class="footer-container">
			<div class="footer-logo">
				<h3>RewareAI</h3>
				<p class="footer-tagline">Next-Gen AI-Native Security Scanning</p>
			</div>
			
			<div class="footer-links">
				<div class="footer-links-column">
					<h4 class="footer-links-title">Products</h4>
					<ul class="footer-links-list">
						<li><a href="#" class="footer-link">AI Scanner</a></li>
						<li><a href="#" class="footer-link">Enterprise Solutions</a></li>
						<li><a href="#" class="footer-link">Integrations</a></li>
						<li><a href="#" class="footer-link">Pricing</a></li>
					</ul>
				</div>
				
				<div class="footer-links-column">
					<h4 class="footer-links-title">Resources</h4>
					<ul class="footer-links-list">
						<li><a href="#" class="footer-link">Documentation</a></li>
						<li><a href="/blog" class="footer-link">Blog</a></li>
						<li><a href="#" class="footer-link">Case Studies</a></li>
						<li><a href="#" class="footer-link">Webinars</a></li>
					</ul>
				</div>
				
				<div class="footer-links-column">
					<h4 class="footer-links-title">Company</h4>
					<ul class="footer-links-list">
						<li><a href="#" class="footer-link">About Us</a></li>
						<li><a href="#" class="footer-link">Careers</a></li>
						<li><a href="#contact" class="footer-link">Contact</a></li>
						<li><a href="#" class="footer-link">Partners</a></li>
					</ul>
				</div>
				
				<div class="footer-links-column">
					<h4 class="footer-links-title">Legal</h4>
					<ul class="footer-links-list">
						<li><a href="#" class="footer-link">Privacy Policy</a></li>
						<li><a href="#" class="footer-link">Terms of Service</a></li>
						<li><a href="#" class="footer-link">Cookie Policy</a></li>
					</ul>
				</div>
			</div>
		</div>
		
		<div class="footer-bottom">
			<div class="footer-container">
				<div class="footer-copyright">
					&copy; {new Date().getFullYear()} RewareAI. All rights reserved.
				</div>
				<div class="footer-social">
					<a href="#" class="footer-social-link" aria-label="Twitter">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
					</a>
					<a href="#" class="footer-social-link" aria-label="LinkedIn">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
					</a>
					<a href="#" class="footer-social-link" aria-label="GitHub">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
					</a>
				</div>
			</div>
		</div>
	</footer>
</Layout>

<!-- Contact form script -->
<script is:inline src="/scripts/contact-form.js"></script>

<style>
	/* Navigation Styles */

	/* Navigation Styles */
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: rgba(26, 27, 58, 0.9);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding: 1rem 0;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 2rem;
	}

	.nav-logo h2 {
		color: #00ffcc;
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.nav-menu {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 2rem;
	}

	.nav-link {
		color: white;
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}

	.nav-link:hover {
		color: #00ffcc;
	}

	/* Hero Section */
	.hero {
		min-height: 80vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px 2rem 20px;
		position: relative;
	}

	.hero::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: 
			radial-gradient(circle at 20% 80%, rgba(0, 255, 204, 0.1) 0%, transparent 50%),
			radial-gradient(circle at 80% 20%, rgba(0, 255, 204, 0.1) 0%, transparent 50%);
		pointer-events: none;
	}

	.hero-container {
		max-width: 1200px;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	/* Hero Background */
	.hero-background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: 
			radial-gradient(circle at 20% 80%, rgba(0, 255, 204, 0.1) 0%, transparent 50%),
			radial-gradient(circle at 80% 20%, rgba(0, 255, 204, 0.1) 0%, transparent 50%);
		z-index: 0;
		opacity: 0.5;
		pointer-events: none;
	}

	.hero-title {
		font-size: clamp(3rem, 8vw, 6rem);
		font-weight: 600;
		line-height: 1.1;
		margin: 40px 0 2rem 0;
		background: linear-gradient(135deg, #ffffff 0%, #00ffcc 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-description {
		font-size: 1.25rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.8);
		margin: 0 auto 3rem auto;
		max-width: 600px;
	}

	.hero-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Features Section */
	.features {
		padding: 120px 2rem;
		position: relative;
		background: linear-gradient(135deg, #1a1b3a 0%, #2d1b69 100%);
	}

	.features::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: 
			radial-gradient(circle at 70% 30%, rgba(0, 255, 204, 0.05) 0%, transparent 50%),
			radial-gradient(circle at 30% 70%, rgba(0, 255, 204, 0.05) 0%, transparent 50%);
		pointer-events: none;
	}

	.features-container {
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}

	.features-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.features-title {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 800;
		margin: 0 0 1.5rem 0;
		background: linear-gradient(135deg, #ffffff 0%, #00ffcc 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.features-subtitle {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.7);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		margin-top: 4rem;
	}

	.feature-card {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(0, 255, 204, 0.2);
		border-radius: 20px;
		padding: 2.5rem;
		text-align: center;
		backdrop-filter: blur(10px);
		transition: all 0.3s ease;
		position: relative;
		overflow: hidden;
	}

	.feature-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, #00ffcc, #00d4aa);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.feature-card:hover {
		transform: translateY(-5px);
		border-color: rgba(0, 255, 204, 0.4);
		box-shadow: 0 20px 40px rgba(0, 255, 204, 0.1);
	}

	.feature-card:hover::before {
		opacity: 1;
	}

	.feature-icon {
		margin-bottom: 1.5rem;
		display: flex;
		justify-content: center;
	}

	.icon-bg {
		width: 80px;
		height: 80px;
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
		position: relative;
		background: rgba(0, 255, 204, 0.1);
		border: 1px solid rgba(0, 255, 204, 0.2);
	}

	.brain-icon {
		background: linear-gradient(135deg, rgba(0, 255, 204, 0.15), rgba(0, 212, 170, 0.15));
	}

	.lightning-icon {
		background: linear-gradient(135deg, rgba(255, 193, 7, 0.15), rgba(255, 152, 0, 0.15));
	}

	.target-icon {
		background: linear-gradient(135deg, rgba(255, 87, 87, 0.15), rgba(255, 64, 129, 0.15));
	}

	.integration-icon {
		background: linear-gradient(135deg, rgba(103, 58, 183, 0.15), rgba(156, 39, 176, 0.15));
	}

	.feature-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 1rem 0;
		color: white;
	}

	.feature-description {
		font-size: 1rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.7);
		margin: 0;
	}

	/* Benefits Section */
	.benefits {
		padding: 120px 2rem;
		position: relative;
		background: linear-gradient(135deg, #2d1b69 0%, #1a1b3a 100%);
	}

	.benefits::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: 
			radial-gradient(circle at 30% 20%, rgba(0, 255, 204, 0.06) 0%, transparent 40%),
			radial-gradient(circle at 70% 80%, rgba(0, 255, 204, 0.06) 0%, transparent 40%);
		pointer-events: none;
	}

	.benefits-container {
		max-width: 1000px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}

	.benefits-header {
		text-align: center;
		margin-bottom: 5rem;
	}

	.benefits-title {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 800;
		margin: 0 0 1.5rem 0;
		background: linear-gradient(135deg, #ffffff 0%, #00ffcc 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.benefits-subtitle {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.7);
		max-width: 700px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.benefits-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.benefit-item {
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
		border: 1px solid rgba(0, 255, 204, 0.1);
		border-radius: 16px;
		padding: 0;
		backdrop-filter: blur(20px);
		transition: all 0.4s ease;
		position: relative;
		overflow: hidden;
	}

	.benefit-item::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 4px;
		background: linear-gradient(180deg, #00ffcc, #00d4aa);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.benefit-item:hover {
		transform: translateX(8px);
		border-color: rgba(0, 255, 204, 0.25);
		box-shadow: 0 10px 40px rgba(0, 255, 204, 0.1);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.06) 100%);
	}

	.benefit-item:hover::before {
		opacity: 1;
	}

	.benefit-content {
		display: flex;
		align-items: center;
		padding: 2.5rem;
		gap: 2rem;
	}

	.benefit-icon-wrapper {
		flex-shrink: 0;
	}

	.benefit-icon {
		width: 70px;
		height: 70px;
		border-radius: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.8rem;
		position: relative;
		border: 2px solid transparent;
		transition: all 0.3s ease;
	}

	.rocket-bg {
		background: linear-gradient(135deg, rgba(0, 255, 204, 0.15), rgba(0, 212, 170, 0.15));
		border-color: rgba(0, 255, 204, 0.3);
	}

	.shield-bg {
		background: linear-gradient(135deg, rgba(255, 193, 7, 0.15), rgba(255, 152, 0, 0.15));
		border-color: rgba(255, 193, 7, 0.3);
	}

	.tools-bg {
		background: linear-gradient(135deg, rgba(255, 87, 87, 0.15), rgba(255, 64, 129, 0.15));
		border-color: rgba(255, 87, 87, 0.3);
	}

	.protection-bg {
		background: linear-gradient(135deg, rgba(103, 58, 183, 0.15), rgba(156, 39, 176, 0.15));
		border-color: rgba(103, 58, 183, 0.3);
	}

	.benefit-text {
		flex: 1;
	}

	.benefit-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.8rem 0;
		color: white;
	}

	.benefit-description {
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.7);
		margin: 0;
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.nav-container {
			padding: 0 1rem;
		}

		.nav-menu {
			gap: 1rem;
		}

		.hero {
			padding: 100px 1rem 40px;
		}

		.hero-buttons {
			flex-direction: column;
			align-items: center;
		}

		.btn {
			width: 100%;
			max-width: 280px;
		}

		.features {
			padding: 80px 1rem;
		}

		.features-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.feature-card {
			padding: 2rem;
		}

		.features-title {
			font-size: 2.5rem;
		}

		.features-subtitle {
			font-size: 1.1rem;
		}

		.benefits {
			padding: 80px 1rem;
		}

		.benefits-list {
			gap: 1.5rem;
		}

		.benefit-content {
			padding: 2rem;
			gap: 1.5rem;
		}

		.benefit-icon {
			width: 60px;
			height: 60px;
			font-size: 1.5rem;
		}

		.benefits-title {
			font-size: 2.5rem;
		}

		.benefits-subtitle {
			font-size: 1.1rem;
		}

		.hero-background {
			opacity: 0.3;
		}
		
		.contact-content {
			flex-direction: column;
		}
		
		.contact-info {
			margin-bottom: 2rem;
		}
	}

	@media (max-width: 480px) {
		.nav-menu {
			display: none;
		}

		.hero-title {
			font-size: 2.5rem;
		}

		.hero-description {
			font-size: 1.1rem;
		}

		.features {
			padding: 60px 1rem;
		}

		.features-header {
			margin-bottom: 3rem;
		}

		.features-title {
			font-size: 2rem;
		}

		.feature-card {
			padding: 1.5rem;
		}

		.icon-bg {
			width: 60px;
			height: 60px;
			font-size: 1.5rem;
		}

		.feature-title {
			font-size: 1.3rem;
		}

		.benefits {
			padding: 60px 1rem;
		}

		.benefits-header {
			margin-bottom: 3rem;
		}

		.benefits-title {
			font-size: 2rem;
